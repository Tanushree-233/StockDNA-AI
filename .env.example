# ==============================================================================
# StockDNA-AI Environment Configuration Template
# Copy this file to .env and configure values for local or cloud deployment.
# NEVER commit .env containing production credentials or real secrets to git.
# ==============================================================================

# Server & Runtime Configuration
APP_ENV=production
HOST=0.0.0.0
PORT=8000

# Security & Authentication
# Required in production: Generate a random 32-byte secret (e.g. openssl rand -hex 32)
JWT_SECRET_KEY=change-this-to-a-secure-random-32-byte-secret-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Database Persistence
# Default for zero-config local runs and ephemeral cloud tiers:
DATABASE_URL=sqlite:///./stockdna.db
# Example for production managed PostgreSQL (e.g. Supabase, Render PostgreSQL, Cloud SQL):
# DATABASE_URL=postgresql://stockdna_user:secure_password@db-host.internal:5432/stockdna_db

# Cross-Origin Resource Sharing (CORS)
# Comma-separated allowed origins (e.g. https://stockdna-ai.onrender.com,http://localhost:5173)
CORS_ORIGINS=*
