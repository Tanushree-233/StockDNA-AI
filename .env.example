# StockDNA-AI Environment Configuration

# Application
APP_ENV=development
PORT=8000
HOST=0.0.0.0

# Security / JWT
JWT_SECRET_KEY=change-this-to-a-secure-random-32-byte-secret-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database
# Local SQLite default:
DATABASE_URL=sqlite:///./stockdna.db
# Production PostgreSQL example:
# DATABASE_URL=postgresql://stockdna_user:password@localhost:5432/stockdna_db
